# Settings for the lab scripts. Copy to .env and fill in your values.
# Keep .env out of git. Sign-in uses `az login`; the only secrets here are the two keys.

# Sign-in with developer logins only (az login and the like): skips the managed identity probe, which waits 1 s on a
# PC. Leave it out when the scripts run on Azure with a managed identity.
AZURE_TOKEN_CREDENTIALS=dev

# Foundry project: the scripts build https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
AZURE_AI_SERVICES_ENDPOINT=https://<resource-name>.services.ai.azure.com/
AZURE_AI_PROJECT_NAME=<project-name>
# Or set the full project endpoint directly (it wins over the two above):
# AZURE_AI_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>

# Azure OpenAI endpoint of the same Foundry resource
OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
OPENAI_API_VERSION=2024-08-01-preview

# Model deployments
MODEL_DEPLOYMENT_NAME=gpt-4o-mini
EMBEDDING_MODEL_DEPLOYMENT_NAME=text-embedding-3-small
# Image embeddings and image generation scripts of the embeddings lab
IMAGE_EMBEDDING_MODEL_DEPLOYMENT_NAME=embed-v-4-0
IMAGE_MODEL_DEPLOYMENT_NAME=gpt-image-2
# Phi-4 lab
PHI_MODEL_DEPLOYMENT_NAME=Phi-4
PHI_REASONING_MODEL_DEPLOYMENT_NAME=Phi-4-reasoning
# DeepSeek lab (DeepSeek-V4-Flash, the successor of the deprecated DeepSeek-R1)
DEEPSEEK_MODEL_DEPLOYMENT_NAME=DeepSeek-V4-Flash
# Chat model of the basic chat and Basic RAG labs, and judge model for the evaluation and GenAI Ops labs
OPENAI_DEPLOYMENT_NAME=gpt-4o

# Azure AI Search
AZURE_AI_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_AI_SEARCH_API_KEY=<search-admin-key>
# Optional, the RAG labs use their own index name when unset
# SEARCH_INDEX_NAME=<index-name>

# Bing lab (src/2-agents/4-bing-grounding.py): the project connection to your Grounding with Bing resource
GROUNDING_WITH_BING_CONNECTION_NAME=<bing-connection-name>

# Azure Functions MCP lab (src/2-agents/6-agents-az-functions-mcp.py); the client test uses the local server when the URL is unset
AZURE_FUNCTIONS_MCP_URL=https://<function-app>.azurewebsites.net/runtime/webhooks/mcp
AZURE_FUNCTIONS_MCP_KEY=<mcp-extension-key>
# Optional, only used in the start command the agent script prints when the app is stopped
# AZURE_RESOURCE_GROUP=<resource-group>

# Optional: save every run's web calls under runs/recordings/, to run it again later without Azure (docs/setup.md)
# HTTP_REPLAY=record
